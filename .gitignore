.venv/
venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Local AI development workspace
.kiro/

# Local data files and audit samples (exclude raw external data from version control)
reports/ceda_*_sample.json
reports/ictd_*_labels*.csv
# Anchored to repo root so source packages such as src/data/ are not ignored.
# Raw and processed CEDA data stay local (redistribution not granted); only
# provenance READMEs and dataset metadata (checksums, counts) are tracked.
/data/**
!/data/**/
!/data/raw/README.md
!/data/processed/README.md
!/data/processed/*.meta.json
*.parquet

# Notebook checkpoints
.ipynb_checkpoints/

# Derived files that embed CEDA source values (daily prices/arrivals) stay local (DEC-022)
reports/forecasts/
reports/runs/**/forecasts/
reports/tables/anomaly_scores.csv
reports/runs/**/anomaly_scores.csv
