{
  "random_seed": 20261023,
  "paths": {
    "raw_dir": "data/raw/ceda",
    "manifest": "data/raw/ceda_manifest.json",
    "audit_report": "data/raw/m2_validation_audit.json",
    "processed_dir": "data/processed",
    "figures_dir": "figures",
    "tables_dir": "reports/tables",
    "reports_dir": "reports",
    "experiment_log": "reports/experiment_log.jsonl",
    "ictd_labels": {
      "onion_maharashtra": "reports/ictd_onion_labels.csv",
      "potato_uttar_pradesh": "reports/ictd_potato_labels.csv"
    },
    "forecasts_dir": "reports/forecasts",
    "runs_dir": "reports/runs"
  },
  "dataset": {
    "version": "v1",
    "start_date": "2016-01-01",
    "end_date": "2022-12-31",
    "chunk_months": 6,
    "series": {
      "onion_maharashtra": {
        "commodity": "Onion",
        "state": "Maharashtra",
        "commodity_id": 23,
        "census_state_id": 27,
        "ictd_state": "MAHARASHTRA"
      },
      "potato_uttar_pradesh": {
        "commodity": "Potato",
        "state": "Uttar Pradesh",
        "commodity_id": 24,
        "census_state_id": 9,
        "ictd_state": "UTTAR PRADESH"
      }
    },
    "extreme_value_factor": 100.0
  },
  "attribution": "Data: CEDA Agri Market Data, Centre for Economic Data and Analysis (CEDA), Ashoka University; original source DMI, Ministry of Agriculture and Farmers Welfare (Agmarknet).",
  "eda": {
    "bootstrap_block_months": 6,
    "bootstrap_reps": 2000
  },
  "forecasting": {
    "protocol_version": "1.1",
    "split": {
      "train": 0.6,
      "validation": 0.2,
      "test": 0.2
    },
    "horizon_market_days": 1,
    "seasonal_period": 7,
    "test_refit_every": 1,
    "validation_refit_every": 7,
    "features": {
      "price_lags": [
        1,
        2,
        3,
        5,
        7
      ],
      "rolling_windows": [
        7,
        14
      ],
      "calendar": [
        "dow_origin",
        "month_origin",
        "dow_target"
      ],
      "arrival_lags": [
        1,
        2
      ],
      "model_input_transform": "log-ratio to last price; target = next log return"
    },
    "models": {
      "naive": {},
      "seasonal_naive": {
        "period": 7
      },
      "linear_regression": {},
      "decision_tree": {
        "grid": {
          "max_depth": [
            3,
            5,
            8
          ],
          "min_samples_leaf": [
            5,
            20,
            50
          ]
        }
      },
      "random_forest": {
        "n_estimators": 300,
        "n_jobs": 4,
        "grid": {
          "max_depth": [
            5,
            10,
            null
          ],
          "min_samples_leaf": [
            5,
            20
          ],
          "max_features": [
            0.5,
            1.0
          ]
        }
      },
      "sarima": {
        "d": 1,
        "seasonal_period": 7,
        "grid": {
          "p": [
            0,
            1,
            2
          ],
          "q": [
            0,
            1,
            2
          ],
          "P": [
            0,
            1
          ],
          "Q": [
            0,
            1
          ]
        },
        "top_k_by_aic": 3,
        "maxiter": 200
      },
      "ets": {
        "seasonal": "add",
        "seasonal_period": 7,
        "grid": {
          "trend": [
            null,
            "add_damped"
          ]
        }
      }
    },
    "comparison": {
      "baseline": "naive",
      "dm_loss": "absolute",
      "fdr_alpha": 0.05
    }
  },
  "anomaly": {
    "protocol_version": "1.0",
    "residual_model": "sarima order with lowest training-set AIC (reports/tables/forecast_sarima_aic.csv)",
    "residual_burn_in_market_days": 182,
    "residual_refit_every": 28,
    "zscore_window": 30,
    "robust": {
      "level_window": 28,
      "weekday_history": 52,
      "scale_window": 56
    },
    "standardize_min_periods": 90,
    "weights": {
      "residual": 0.5,
      "robust": 0.5
    },
    "threshold": 3.0,
    "threshold_sensitivity": [
      2.5,
      3.0,
      3.5,
      4.0,
      5.0
    ],
    "coverage_arrival_fraction_of_median": 0.1,
    "weak_labels": {
      "label_columns": [
        "lastMonth",
        "lastYear",
        "SameMonth"
      ],
      "positive_value": "Anomaly",
      "permutations": 1000
    },
    "shocks": {
      "segment": "test",
      "magnitudes": [
        -0.5,
        -0.3,
        -0.2,
        -0.1,
        0.1,
        0.2,
        0.3,
        0.5
      ],
      "shocks_per_run": 6,
      "min_gap_market_days": 60,
      "repeats": 5,
      "exclude_days_after_shock": 7,
      "residual_params": "frozen at segment start (state updates only)"
    }
  }
}
